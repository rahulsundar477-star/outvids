{
  "name": "outvids",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:local": "node scripts-dev-local.mjs",
    "dev:seed": "node scripts-local-seed.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "panic": "wrangler deploy --config wrangler.maintenance.jsonc",
    "resume": "npm run deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "indexnow": "node scripts-indexnow.mjs",
    "usage": "node scripts-usage.mjs",
    "security:reports": "node scripts-security-reports.mjs",
    "db:snapshot": "node scripts-db-snapshot.mjs",
    "test:payments": "node tests/run-payments.mjs",
    "golive:check": "node scripts-golive.mjs check",
    "golive:clean-test": "node scripts-golive.mjs clean-test",
    "test:feed": "node tests/run-feed.mjs",
    "bench:enrich": "node tests/run-bench.mjs",
    "test": "npm run test:payments && npm run test:feed && node tests/check-security-txt.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "dodopayments": "^2.50.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.133.0"
  }
}
