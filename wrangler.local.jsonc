{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local-only preview config: same Worker, but every binding is on-disk in .wrangler/state.
  // Nothing here can reach production — no `remote: true`, no routes, no real secrets.
  //   npm run dev:local     (seeds the local D1 + R2, then runs wrangler dev on :8787)
  // Seed data lives in scripts-local-seed.mjs. Production stays untouched.
  "name": "outvids",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "r2_buckets": [{ "binding": "CLIPS", "bucket_name": "clips" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outvids",
      "database_id": "84e14d12-c064-4ace-b5d2-9f095671a552",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    // Checkout stays off locally: no API key, so /api/checkout answers 503 and nothing is ever charged.
    "DODO_ENVIRONMENT": "test_mode",
  },
  "ratelimits": [
    {
      "name": "CHECKOUT_RL",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
